# Copy to ~/.config/keiba-monitor.env, chmod 600, and fill the dedicated OAuth client credentials.
MONITOR_COLLECTOR_PATH=/absolute/path/to/keiba-ai/services/monitor/collector.py
MONITOR_API_URL=http://localhost/api
MONITOR_CLIENT_ID=
MONITOR_CLIENT_SECRET=
MONITOR_HOST_ID=keiba-pc
# Set vm when the collector runs in WSL/a VM rather than on the physical host.
MONITOR_SCOPE=host
# Use real host paths. Filesystems shared by several roles are deduplicated.
MONITOR_DISKS="OS=/;取得データ=/absolute/path/to/keiba-ai/services/scraper/data"
# Optional: required for VM NICs without /sys/class/net/<name>/device.
# MONITOR_INTERFACES=eth0
