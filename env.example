# v1.0.0: 全サービスを1台のPCで実行する
TZ=Asia/Tokyo
WEB_PORT=80
POSTGRES_DB=keiba
POSTGRES_USER=keiba
POSTGRES_PASSWORD=keiba
SECRET_KEY=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpass

# 同一PC内のscraperとの通信。接続先はcompose.yamlで固定。
SCRAPER_FORWARD_TIMEOUT_SEC=300
# 定期同期の起動時刻。取得間隔は画面の同期設定で制御。
SCRAPE_SYNC_CRON=5 0 * * *

# PC監視の警告値。CPU・メモリは5分継続で判定。
MONITOR_CPU_WARNING=80
MONITOR_CPU_CRITICAL=95
MONITOR_MEMORY_WARNING=80
MONITOR_MEMORY_CRITICAL=90
MONITOR_DISK_WARNING=80
MONITOR_DISK_CRITICAL=90
MONITOR_DISK_MIN_FREE_BYTES=0

# 必要時のみ起動するMLflow / 学習ジョブ
MLFLOW_PORT=5000
MLFLOW_EXPERIMENT_NAME=keiba-win-v1
MLFLOW_MODEL_NAME=keiba_win_classifier
MLFLOW_MODEL_STAGE=Production
MLFLOW_MODEL_CACHE_TTL_SEC=300
