TZ=Asia/Tokyo

# -----------------------------
# PC side (docker-compose.pc.yaml)
# -----------------------------
POSTGRES_DB=keiba
POSTGRES_USER=keiba
POSTGRES_PASSWORD=keiba

# worker/pipeline (optional)
API_BASE_URL=http://api:8001

# scraper-service control API (Pi side)
# 例:
#   - PC IP: 100.103.236.14
#   - Pi IP: 100.124.136.103
#   SCRAPER_CONTROL_BASE_URL=http://100.124.136.103:8080
SCRAPER_CONTROL_BASE_URL=http://127.0.0.1:8080
# scraper control timeout (seconds)
SCRAPER_FORWARD_TIMEOUT_SEC=60

# api-sync-cron
SCRAPE_SYNC_CRON=5 0 * * *
SCRAPE_SYNC_API_URL=http://api:8001

# -----------------------------
# frontend (optional)
# -----------------------------
# reverse-proxy が `/api` を公開している場合は `/api` のままでOK
VITE_API_BASE_URL=/api

# Vite HMR (optional; reverse-proxy 経由で ws://localhost:5173 になってしまう場合に指定)
# 例:
#   VITE_HMR_HOST=100.103.236.14
#   VITE_HMR_CLIENT_PORT=80
#   VITE_HMR_PROTOCOL=ws
VITE_HMR_HOST=
VITE_HMR_CLIENT_PORT=
VITE_HMR_PROTOCOL=

# -----------------------------
# Pi side (docker-compose.pi.yaml)
# -----------------------------
# PC の reverse-proxy を経由する場合は http://<pc-lan-ip>/api にする
PC_API_URL=http://reverse-proxy/api

# 将来: api-service ⇔ scraper-service の認証導入時に利用
API_ACCESS_TOKEN=

# scraper-service ports / cron
SCRAPER_CONTROL_PORT=8080
SCRAPER_HEALTH_PORT=8081
SCRAPER_CRON=0 6 * * *

