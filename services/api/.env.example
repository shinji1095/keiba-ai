# ------------------------------
# App
# ------------------------------
APP_NAME="Keiba AI API"
ENVIRONMENT="local"

# Secret for signing JWT (change in production)
SECRET_KEY="change-me-in-production"
JWT_ISSUER="keiba-ai"
JWT_AUDIENCE="keiba-ai"

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cookie
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE="lax"
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_PATH="/"

# ------------------------------
# Database
# ------------------------------
# Default uses SQLite file inside container. For production, set Postgres URL.
DATABASE_URL="sqlite:////app/data/app.db"

# ------------------------------
# Redis (token rotation / revocation)
# ------------------------------
# Optional in local. Recommended in production.
REDIS_URL="redis://redis:6379/0"
REDIS_ENABLED=false

# ------------------------------
# Admin bootstrap user (created on startup if missing)
# ------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="adminpass"
ADMIN_ROLE="admin"
